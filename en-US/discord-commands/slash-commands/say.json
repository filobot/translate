{
  "description": "Send a message using Filo.",
  "subcommands": {
    "embed": {
      "description": "Send the message through an embed.",
      "arguments": {
        "message": {
          "name": "message",
          "description": "Message you want to send."
        },
        "markdown": {
          "name": "markdown",
          "description": "Render Markdown formatting.",
          "choices": {
            "true": "$t(general:YES)",
            "false": "$t(general:NO)"
          }
        },
        "follow-up": {
          "name": "follow-up",
          "description": "Send a separate public message with author attribution.",
          "choices": {
            "true": "$t(general:YES)",
            "false": "$t(general:NO)"
          }
        }
      }
    },
    "normal": {
      "description": "Send the message using a normal message.",
      "arguments": {
        "message": {
          "name": "message",
          "description": "Message you want to send."
        },
        "markdown": {
          "name": "markdown",
          "description": "Render Markdown formatting.",
          "choices": {
            "true": "$t(general:YES)",
            "false": "$t(general:NO)"
          }
        },
        "follow-up": {
          "name": "follow-up",
          "description": "Send a separate public message with author attribution.",
          "choices": {
            "true": "$t(general:YES)",
            "false": "$t(general:NO)"
          }
        }
      }
    }
  }
}
